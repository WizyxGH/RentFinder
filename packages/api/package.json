{
  "name": "@rentfinder/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API serverless (Cloudflare Worker) exposant les annonces à l'interface, protégée par jeton.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./routes": {
      "types": "./dist/routes.d.ts",
      "default": "./dist/routes.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@rentfinder/shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "wrangler": "^3.99.0"
  }
}
