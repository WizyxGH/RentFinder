{
  "name": "@rentfinder/collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Collecte, normalisation, dédoublonnage, scoring et persistance des annonces.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server/routes": {
      "types": "./dist/server/routes.d.ts",
      "default": "./dist/server/routes.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "collect": "tsc --build && node dist/cli/collect.js",
    "draft": "tsc --build && node dist/cli/draft.js",
    "db:migrate": "tsc --build && node dist/cli/migrate.js",
    "serve": "tsc --build && node dist/cli/serve.js"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@rentfinder/shared": "workspace:*",
    "cheerio": "^1.0.0",
    "imapflow": "^1.7.3",
    "mailparser": "^3.9.15"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6"
  }
}
