# Maïoun (dépôt RentFinder) — configuration privée de la MACHINE QUI COLLECTE.
#
# Copier vers `.env` et renseigner. `.env` est ignoré par git, jamais committé.
# Toutes les valeurs ci-dessous sont fictives.
#
# CE FICHIER NE CONFIGURE PAS LE SITE. Le site publié ne lit rien d'ici : il
# parle au Worker, dont les secrets se déposent avec `wrangler secret put`
# (voir plus bas). Ce qui suit ne concerne que la collecte.

# --- BEP Logement (optionnel) ----------------------------------------------
# Espace abonné http://abonnes.beplogement.com. Vides = source en mode public.
#
# ATTENTION, MULTI-COMPTE : cet accès est celui de LA MACHINE QUI COLLECTE,
# pas d'un compte du site. Un abonnement payé est nominatif ; le partager
# reviendrait à le prêter. Les annonces qu'il révèle entrent donc en base pour
# tout le monde — c'est le choix assumé d'une collecte unique et partagée. Si
# ce n'est pas ce que vous voulez, laissez ces deux lignes vides.
BEP_SUBSCRIBER_USER=exemple-identifiant
BEP_SUBSCRIBER_PASSWORD=exemple-mot-de-passe

# --- Collecte (§10) ---------------------------------------------------------
# User-Agent honnête : le projet ne se fait jamais passer pour un navigateur.
COLLECTOR_USER_AGENT=RentFinderBot/0.1 (+https://github.com/example-user/rentfinder)
# Backfill (§8) : descend dans l'historique. À `true` seulement à dessein.
BACKFILL_ENABLED=false
# INTERRUPTEUR GÉNÉRAL de l'envoi automatique de candidatures (§23). Il reste à
# `false` : aucun message ne part sans un geste explicite. La mécanique de
# garde-fous existe déjà (plafonds, historique, sources autorisées) et attend
# cet interrupteur — le retirer reviendrait à retirer le frein avant la voiture.
AUTO_CONTACT_ENABLED=false

# --- Profil locataire (§25) -------------------------------------------------
# Valeur de départ pour les messages de candidature composés PAR LA COLLECTE.
# Le profil affiché sur le site, lui, vit dans le navigateur de chacun
# (Paramètres → Profil locataire) : ces lignes ne le remplacent pas.
TENANT_FIRST_NAME=Prenom
TENANT_LAST_NAME=Nom
TENANT_EMAIL=prenom.nom@example.invalid
TENANT_PHONE=+33600000000
TENANT_SITUATION=CDI
TENANT_MONTHLY_INCOME=2000
# Garantie de loyer : none | physical | visale | garantme | other
# visale = garantie gratuite d'Action Logement, a demander sur visale.fr.
# TENANT_GUARANTOR_NAME ne sert que pour "other" (Loca-Pass, Cautioneo...).
TENANT_GUARANTOR=physical
# TENANT_GUARANTOR_NAME=
TENANT_MOVE_IN_DATE=2026-09-01
# Message unique, repris tel quel (le lien de l'annonce est ajouté en pied).
# Sinon un message est composé à partir des champs ci-dessus.
# TENANT_APPLICATION_MESSAGE="Bonjour,
#
# Votre annonce m'intéresse. …
#
# Cordialement,
# Prénom"

# --- Adresses de référence pour les distances (§20) -------------------------
# VALEURS DE DÉPART SEULEMENT. Ces adresses se règlent depuis le site
# (Paramètres → Adresses de référence) et y sont alors prioritaires : elles
# vivent en base, donc par compte, et suivent d'un appareil à l'autre. Ce qui
# suit ne sert plus qu'à amorcer une machine où rien n'a encore été réglé.
# Au choix : une ADRESSE (géocodée une fois) ou des COORDONNÉES, qui priment.
REFERENCE_WORK_LABEL=Travail
# REFERENCE_WORK_ADDRESS="20 avenue Jean Médecin, Nice"
REFERENCE_WORK_LAT=43.7031
REFERENCE_WORK_LON=7.2661

REFERENCE_STATION_LABEL=Gare
# REFERENCE_STATION_ADDRESS="Gare de Nice-Ville"
REFERENCE_STATION_LAT=43.7045
REFERENCE_STATION_LON=7.2619

# Sans jeton Navitia, la durée est estimée ; avec, elle est réelle et calculée
# pour arriver à l'heure ci-dessous. Le plafond de trajet se règle DEPUIS LE
# SITE (Trier et filtrer), comme les autres critères.
# NAVITIA_TOKEN=
WORK_ARRIVAL_TIME=09:00

# --- Import des alertes e-mail (§6, §10) ------------------------------------
# Voie conforme pour Leboncoin/SeLoger : le portail envoie ses annonces par
# e-mail, RentFinder les lit dans VOTRE boîte en lecture seule. Gmail : activer
# IMAP et créer un MOT DE PASSE D'APPLICATION.
#
# MULTI-COMPTE : une seule boîte est lue, celle de la machine qui collecte. Les
# annonces qui en sortent alimentent la base commune. Lire la boîte de chaque
# compte demanderait de conserver un mot de passe d'application par personne —
# donc des identifiants de messagerie dans une base — ce que ce projet refuse
# (§26). Voir docs/architecture.md.
# Seuls les e-mails PROVENANT des portails sont lus, jamais les autres (§26).
# IMAP_USER=prenom.nom@example.invalid
# IMAP_APP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_MAILBOX=INBOX

# --- Journal et liens des notifications -------------------------------------
# Adresse du site publié, utilisée pour que chaque notification renvoie à la
# BONNE fiche. Par défaut, l'adresse GitHub Pages du projet ; à changer le jour
# où le site prend son propre domaine.
# SITE_URL=https://exemple.github.io/RentFinder/
# Sortie narrée par défaut (phrases lisibles) ; `json` pour l'analyser.
# LOG_FORMAT=json

# --- Base de données --------------------------------------------------------
# Par défaut : fichier SQLite local créé automatiquement, rien à configurer.
# `DATABASE_URL` ne sert qu'à pointer un AUTRE fichier local ; les tests
# utilisent une base en mémoire — ne jamais viser la base de travail (§52).
# DATABASE_URL=file:./data/local.db
# TEST_DATABASE_URL=file:./data/test.db

# --- Mode cloud (optionnel, §28) --------------------------------------------
# Base Turso privée, lue par l'interface hébergée. Voir docs/deployment.md.
# TURSO_DATABASE_URL=libsql://exemple-base.turso.io
# TURSO_AUTH_TOKEN=

# --- Worker Cloudflare (§28) ------------------------------------------------
# L'API du site publié. SES SECRETS NE VIVENT PAS ICI : ils se déposent une
# fois avec `wrangler secret put`, du côté de la plateforme, précisément pour
# que le jeton Turso ne redescende jamais dans un navigateur (§26).
#
#   npx wrangler secret put TURSO_DATABASE_URL
#   npx wrangler secret put TURSO_AUTH_TOKEN
#   npx wrangler secret put SESSION_SECRET     # longue chaîne aléatoire
#
# `TURSO_*` ci-dessus restent utiles à CETTE machine : la collecte et la
# création de comptes (`user:add`) écrivent en base directement.

# --- Notifications Web Push (§29) -------------------------------------------
# Alerte téléphone rangé, émise par la collecte planifiée — aucun serveur en
# plus. Générer une paire : `npx web-push generate-vapid-keys`.
# La clé PUBLIQUE part dans le site (ce n'est pas un secret) ; la PRIVÉE reste
# ici et dans les secrets GitHub.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:vous@example.invalid
