# ---------------------------------------------------------------------------
# RentFinder — exemple de configuration privée
#
# Copier ce fichier vers `.env` puis renseigner les vraies valeurs.
# `.env` est ignoré par git (voir .gitignore) et ne doit JAMAIS être committé.
#
# TOUTES les valeurs ci-dessous sont FICTIVES. Ne jamais remplacer un exemple
# par une vraie donnée dans ce fichier (§26, §66).
# ---------------------------------------------------------------------------

# ===========================================================================
# ACCÈS ABONNÉ BEP LOGEMENT — PRIVÉ (accès payé par l'utilisateur, §6)
# ===========================================================================
# Identifiants de votre espace abonné http://abonnes.beplogement.com.
# S'y connecter est légitime (accès payé) ; ces identifiants restent PRIVÉS —
# jamais committés (§26). Laisser vides = la source BEP reste en mode public.
# Attention : le portail est en http:// (non chiffré).
BEP_SUBSCRIBER_USER=exemple-identifiant
BEP_SUBSCRIBER_PASSWORD=exemple-mot-de-passe

# ===========================================================================
# BASE DE DONNÉES — SQLite local (§27)
# ===========================================================================
# Le projet est 100% local : la base est un fichier SQLite créé automatiquement
# dans data/local.db (ignoré par git). Aucune configuration nécessaire.
# DATABASE_URL n'est utile que pour pointer vers un AUTRE fichier local.
# DATABASE_URL=file:./data/local.db

# Pour les tests, une base en mémoire est utilisée. Ne JAMAIS pointer cette
# variable vers votre base de travail (§52).
# TEST_DATABASE_URL=file:./data/test.db


# ===========================================================================
# COLLECTE (§10, §6)
# ===========================================================================
# User-Agent envoyé par le collecteur. Doit rester identifiable et honnête :
# le projet ne se fait jamais passer pour un navigateur (§10).
COLLECTOR_USER_AGENT=RentFinderBot/0.1 (+https://github.com/example-user/rentfinder)

# Mode BACKFILL — désactivé par défaut (§8). Ne l'activer que ponctuellement.
BACKFILL_ENABLED=false

# Interrupteur global du contact automatique (§23). OFF par défaut.
# Tant que cette valeur n'est pas `true`, aucun message ne peut partir seul.
AUTO_CONTACT_ENABLED=false


# ===========================================================================
# PROFIL LOCATAIRE — PRIVÉ (§25)
# ===========================================================================
# Ces valeurs alimentent les templates de message. Elles ne quittent jamais
# votre machine (projet 100% local).
TENANT_FIRST_NAME=Prenom
TENANT_LAST_NAME=Nom
TENANT_EMAIL=prenom.nom@example.invalid
TENANT_PHONE=+33600000000
TENANT_SITUATION=CDI
TENANT_MONTHLY_INCOME=2000
TENANT_HAS_GUARANTOR=true
TENANT_MOVE_IN_DATE=2026-09-01


# ===========================================================================
# POINTS DE RÉFÉRENCE POUR LES DISTANCES — PRIVÉ (§20)
# ===========================================================================
# Deux façons de définir un point de référence, au choix :
#
#   1. PAR ADRESSE (le plus simple) — géocodée une fois via l'API officielle
#      Base Adresse Nationale au démarrage de la collecte :
#          REFERENCE_WORK_ADDRESS="20 avenue Jean Médecin, Nice"
#   2. PAR COORDONNÉES (exactes) — priment sur l'adresse si les deux sont
#      renseignées :
#          REFERENCE_WORK_LAT / REFERENCE_WORK_LON
#
# Les valeurs ci-dessous pointent vers des lieux publics génériques de Nice.
# Remplacez-les par les vôtres dans `.env` uniquement (jamais versionné, §26).
REFERENCE_WORK_LABEL=Travail
# REFERENCE_WORK_ADDRESS="20 avenue Jean Médecin, Nice"
REFERENCE_WORK_LAT=43.7031
REFERENCE_WORK_LON=7.2661

REFERENCE_STATION_LABEL=Gare
# REFERENCE_STATION_ADDRESS="Gare de Nice-Ville"
REFERENCE_STATION_LAT=43.7045
REFERENCE_STATION_LON=7.2619
